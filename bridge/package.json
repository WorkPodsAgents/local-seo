{
  "name": "@workpods/local-seo",
  "author": {
    "name": "WorkPods",
    "url": "https://workpods.ai"
  },
  "version": "1.0.1",
  "description": "Local MCP server and CLI for the Local SEO extension: Google Business Profile and Maps audits.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "local-seo": "dist/cli.js"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/cli.js --banner:js=\"#!/usr/bin/env node\" --external:@modelcontextprotocol/sdk --external:linkedom --external:ws --external:zod",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "linkedom": "0.18.15",
    "ws": "8.18.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@local-seo/core": "*",
    "@open-agent-ready/core": "*",
    "@types/node": "22.19.1",
    "@types/ws": "8.18.1",
    "esbuild": "0.25.12"
  },
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://workpods.ai/tools/local-seo",
  "repository": {
    "type": "git",
    "url": "https://github.com/WorkPodsAgents/local-seo.git",
    "directory": "bridge"
  },
  "bugs": {
    "url": "https://github.com/WorkPodsAgents/local-seo/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "local-seo",
    "google-business-profile",
    "google-maps",
    "reviews",
    "seo",
    "chrome-extension",
    "cli"
  ],
  "contributors": [
    {
      "name": "Shefali Munjal"
    }
  ],
  "mcpName": "ai.workpods/local-seo"
}
